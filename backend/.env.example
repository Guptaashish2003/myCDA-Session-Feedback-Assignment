# Copy to backend/.env and adjust. Every value is optional (defaults shown).
# Used by docker compose (env_file). For a local `python manage.py runserver`,
# export the variables in your shell -- Django reads real environment variables.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-key-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# --- CORS (dev: allow every origin; in production set false and list origins) ---
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

# --- Container start-up (docker_start.py) ---
# if-empty: seed only when there are no users | always: wipe and re-seed | never
SEED_ON_START=if-empty
# true = also create demo reviews for older sessions
SEED_FEEDBACK=false
PORT=8000

# --- Feedback feature ---
FEEDBACK_WINDOW_DAYS=30
FEEDBACK_SUMMARY_WINDOW=10
FEEDBACK_SUMMARY_MIN_RESPONSES=3
